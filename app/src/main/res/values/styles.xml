<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/vert_fonce</item>
        <item name="colorPrimaryDark">@color/vert_fonce</item>
        <item name="colorAccent">@color/or</item>
        <item name="android:windowBackground">@color/gris_clair</item>
        <item name="actionBarStyle">@style/MyActionBar</item>
    </style>

    <style name="MyActionBar" parent="Widget.AppCompat.ActionBar">
        <item name="background">@color/vert_fonce</item>
        <item name="titleTextStyle">@style/MyActionBarTitle</item>
    </style>

    <style name="MyActionBarTitle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@color/blanc</item>
        <item name="android:textSize">18sp</item>
    </style>
</resources>